{
  "name": "Message",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "title": "Event ID"
    },
    "uploader_name": {
      "type": "string",
      "title": "Uploader Name"
    },
    "recipient": {
      "type": "string",
      "title": "Recipient"
    },
    "content": {
      "type": "string",
      "title": "Message Content"
    },
    "organizer_user_id": {
      "type": "string",
      "title": "Organizer User ID"
    }
  },
  "required": [
    "event_id",
    "uploader_name",
    "recipient",
    "content"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.organizer_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": null
  }
}